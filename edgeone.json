{
  "name": "edgeone-blog",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "./out",
  "nodeVersion": "22.11.0",
  "caches": [
    {
      "source": "/_next/static/*",
      "cacheTtl": 31536000
    },
    {
      "source": "/styles/*",
      "cacheTtl": 86400
    },
    {
      "source": "/api/media/*",
      "cacheTtl": 86400
    },
    {
      "source": "/rss.xml",
      "cacheTtl": 300
    },
    {
      "source": "/sitemap.xml",
      "cacheTtl": 3600
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    }
  ]
}
